# Local Docker Database URL (used inside Docker container)
# DATABASE_URI=postgresql://postgres:postgres@db:5432/fcc_conference

# Local Host Database URL (if running npm run dev on host against Docker postgres)
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/fcc_conference

# Production Neon Database URL (for Vercel deployment)
# DATABASE_URI=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Payload Secret (change to a random secure string in production)
PAYLOAD_SECRET=7df8b9a1c2d3e4f5061728394a5b6c7d8e9f0123456789abcdef0123456789ab

# Public Server URL (pnpm dev uses port 3101; docker compose app uses 3000)
NEXT_PUBLIC_SERVER_URL=http://localhost:3101

# Live Preview (required to enable the admin intro preview iframe)
PREVIEW_SECRET=

# Web Push keys (optional). Required for lock-screen alerts when the app is closed.
# Generate with: npx web-push generate-vapid-keys
# Contact email lives in CMS: Globals → Programme alerts.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Required in production when using cron-job.org for session reminders (GET /api/programme-alerts every minute).
# cron-job.org header: Authorization: Bearer <same value>
# CRON_SECRET=

# Vercel Blob Token (optional, used in production for media storage on Vercel)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
# Must match the store access in Vercel (new stores are private). Omit on Vercel to default private.
# BLOB_ACCESS=private
